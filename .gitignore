# Python
__pycache__/
*.py[codz]
*.egg-info/

# Environments
.env
.venv/
venv/

# Editors / OS
.vscode/
.DS_Store

# Claude Code — dev tooling, not part of the physics deliverable
.claude/

# Discussion notes
*.disc.md

# --- Project-specific -------------------------------------------------------
# Regenerated analysis output. The committed deliverable is REPORT.md (derived
# from these); the CSVs themselves are rebuilt by scripts/run_spectrum.py.
results/

# Superseded / oversized PDG dumps. The active data/pdg-*.sqlite stays tracked
# so the pipeline is runnable on a fresh clone; the old "all" dump does not.
data/pdgall*.sqlite

# LaTeX sources + build clutter. Only the built PDFs under submits/ are tracked.
papers/
tex/
prestex/
poster/

# Scratch / explanatory write-ups (e.g. the statistics explainer), not a
# submission artifact -- regenerated on demand.
dump/

# Avoid tracking stray CLAUDE.md variants (the canonical CLAUDE.md is already
# tracked from before this rule existed; git ignore doesn't retroactively
# untrack it).
CLAUDE*
